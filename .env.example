# --- General ---
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
CLIENT_ORIGIN=http://localhost:5173

# --- MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=estim8
DB_PASSWORD=change-me
DB_NAME=estim8
MYSQL_ROOT_PASSWORD=change-me-root

# --- Secrets (generate real random values for production) ---
COOKIE_SECRET=dev-cookie-secret-change-me
VERIFICATION_TICKET_SECRET=dev-verification-secret-change-me

# --- SMTP (Hostinger mailbox) ---
# Most SMTP providers (including Hostinger) reject mail where SMTP_FROM's
# address doesn't match SMTP_USER's mailbox ("550 Sender verify failed").
# Keep SMTP_FROM's address identical to SMTP_USER unless your mailbox is
# explicitly configured to send-as a different address/alias.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="estim8 <noreply@estim8.com>"

# --- Uploads ---
UPLOAD_ROOT=./uploads
MAX_UPLOAD_MB=20
